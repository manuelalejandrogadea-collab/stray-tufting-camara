{
  "expo": {
    "name": "Stray Tufting Camara",
    "slug": "stray-tufting-camara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./logo.png",
        "backgroundColor": "#000000"
      },
      "package": "com.straytufting.camara",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permite acceder a la cámara para tomar fotos de las alfombras."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permite guardar las fotos en la galería."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b0518282-5633-42df-badc-9ad9a4a171d8"
      }
    }
  }
}
